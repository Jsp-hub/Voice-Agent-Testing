# Copy this file to .env and replace the placeholder with your own key.
# Never commit the .env file.
GOOGLE_API_KEY=replace_with_your_google_ai_studio_key

# Change this only to a model available in your Google AI Studio project.
GEMINI_MODEL=gemini-3.1-flash-lite

# LiveKit Cloud project credentials. These are not your Telnyx SIP credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_your_livekit_api_key
LIVEKIT_API_SECRET=replace_with_your_livekit_api_secret

# Used only by the direct Deepgram STT plugin.
DEEPGRAM_API_KEY=replace_with_your_deepgram_key

# xAI TTS runs through LiveKit Inference, so it needs no XAI_API_KEY.
XAI_TTS_MODEL=xai/tts-1
XAI_TTS_VOICE=ara



# Outbound Calling Layer (ConnectiNG livekit to Telnyx)
LIVEKIT_OUTBOUND_TRUNK_ID=ST_your_livekit_outbound_trunk_id
TELNYX_CALLER_NUMBER=+1your_telnyx_number


# Option to save the raw livekit log during call
SAVE_DEBUG_LOGS=False


SCENARIO_ID=choose_scenario